    { "name": "Movimientos", "short_name": "Movimientos", "url": "./#/movements", "icons": [{ "src": "./anada-192.png", "sizes": "192x192" }] },
    { "name": "Tareas", "short_name": "Tareas", "url": "./#/tasks", "icons": [{ "src": "./anada-192.png", "sizes": "192x192" }] }
  ]
