  "icons": [
    { "src": "./anada-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./anada-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./anada-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "./anada-mark.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
